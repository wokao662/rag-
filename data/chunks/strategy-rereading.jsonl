{"chunkId": "c6b78379-dd75-540c-9e40-7c36b5f16f2d", "text": "重复阅读的第 3 步：根据需要继续重复阅读。", "metadata": {"strategyId": "strategy-rereading", "strategyName": "重复阅读", "chunkType": "procedure", "sourceIds": ["source-006"], "reviewStatus": "draft", "recommendationSnapshot": {"evidenceScore": 0.2, "communityScore": 0.9, "effectivenessScore": 0.2, "overallScore": 0.38, "triedCount": 0, "helpfulCount": 0}, "stepNumber": 3, "totalSteps": 4}}
