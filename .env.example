# Copy this file to .env and fill in your own key. Never commit .env.
SILICONFLOW_API_KEY=replace-with-your-own-siliconflow-api-key
QDRANT_URL=http://127.0.0.1:6333

# Local PostgreSQL used for users, conversations, messages and profiles.
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=learning_app
POSTGRES_USER=learning_app
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
